# Neon의 direct(비풀링) 연결 문자열. sslmode=require를 포함합니다.
# uv run --env-file .env ... 명령으로 로드하며 실제 .env는 Git에 넣지 않습니다.
DATABASE_URL=

# 앱 DB와 다른 DB 또는 Neon 테스트 브랜치. 없으면 PostgreSQL 통합 테스트는 건너뜁니다.
TEST_DATABASE_URL=

# 브라우저가 사용하는 프론트 출처
APP_ORIGIN=http://localhost:3000

# 문항 이미지 폴더. 비워 두면 저장소의 data/private/phase2/assets를 사용합니다.
QUESTION_ASSETS_DIR=

# 앱 비밀번호·서명 쿠키는 사용하지 않습니다.
# 운영에서는 Vercel Authentication + All Deployments로 프론트·API·이미지를 보호합니다.
